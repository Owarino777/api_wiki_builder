@startuml uml_05_deployment_docker
title UML 2.5 — Deploiement Docker — Wiki Builder API
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #5D6D7E
skinparam ArrowThickness 1.1

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #ECF0F1
  FontStyle bold
}
skinparam node {
  BackgroundColor #ECF0F1
  BorderColor #2C3E50
  FontStyle bold
}
skinparam database {
  BackgroundColor #D6EAF8
  BorderColor #2471A3
}
skinparam artifact {
  BackgroundColor #F9F9F9
  BorderColor #5D6D7E
}
skinparam folder {
  BackgroundColor #FFF9C4
  BorderColor #F39C12
}

actor "Navigateur utilisateur" as Browser
actor "Developpeur API\n(Postman / cURL)" as ApiClient
actor "Developpeur" as Dev

node "Machine locale ou serveur" as Host {
  node "Docker Compose" as Compose {
    node "web\nnginx:1.27-alpine" as Web {
      artifact "public/\nassets statiques Laravel" as Public
      artifact "docker/nginx/default.conf" as NginxConf
    }

    node "app\nPHP-FPM + Laravel" as App {
      artifact "Code source Laravel" as Source
      artifact "routes/api.php\nroutes/web.php" as Routes
      artifact "Controllers / Services / Models" as LaravelCode
      folder "storage/app/private\nsnapshots CODMunity" as Storage
      folder "vendor_data\nComposer dependencies" as Vendor
    }

    database "db\nMySQL 8.0\nschema wiki_builder" as Db {
      folder "db_data ou db_prod_data" as DbVolume
      artifact "docker/db/init-test-db.sql" as InitTestDb
    }

    node "test\nDockerfile.dev\nprofile testing" as Test
  }

  folder "docker/secrets\nproduction" as Secrets
  artifact ".env local\nvariables Laravel" as EnvLocal
}

Browser --> Web : HTTP 8000 local\nHTTP 80 production
ApiClient --> Web : HTTP /api/v1
Web --> Public : sert les assets
Web --> NginxConf : configuration serveur
Web --> App : FastCGI :9000
App --> Source : volume ./ vers /var/www/html
App --> Routes : resolution web/API
App --> LaravelCode : logique metier
App --> Db : MySQL 3306
App --> Storage : import/export snapshots
App --> Vendor : dependances Composer
Db --> DbVolume : persistance des donnees
Db --> InitTestDb : base de test initiale
App --> EnvLocal : config locale
App --> Secrets : APP_KEY / DB_PASSWORD en production
Db --> Secrets : mot de passe MySQL production
Dev --> Test : docker compose --profile testing
Test --> Source : tests sur le code monte
Test --> Db : base de test

note right of App
Au demarrage local, le conteneur app peut installer Composer,
generer APP_KEY, lancer les migrations et seed la base selon .env.
En production, ces automatisations sont desactivees.
end note

@enduml
